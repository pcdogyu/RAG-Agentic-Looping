# Copy to .env. Never commit real credentials.
FMP_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DATABASE_URL=postgresql+psycopg://agent:agent@postgres:5432/agent
REDIS_URL=redis://redis:6379/0
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EXTRACT_MODEL=qwen2.5:3b
OLLAMA_ASSIST_MODEL=qwen2.5:7b
OLLAMA_RESEARCH_MODEL=qwen2.5:14b
OLLAMA_CODE_MODEL=qwen2.5-coder:7b
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=4
OLLAMA_MAX_QUEUE=256
OLLAMA_LOAD_TIMEOUT=10m
OLLAMA_NUM_THREADS=0
OLLAMA_EXTRACT_NUM_THREADS=8
OLLAMA_ASSIST_NUM_THREADS=8
OLLAMA_RESEARCH_NUM_THREADS=16
OLLAMA_CODE_NUM_THREADS=8
OLLAMA_EXTRACT_MAX_CONCURRENCY=1
OLLAMA_ASSIST_MAX_CONCURRENCY=1
OLLAMA_RESEARCH_MAX_CONCURRENCY=2
OLLAMA_CODE_MAX_CONCURRENCY=1
OLLAMA_MAX_OUTPUT_TOKENS=1024
OLLAMA_KEEP_ALIVE=-1
RESEARCH_PROMPT_EVIDENCE_CHARS=12000
RESEARCH_PROMPT_CONTEXT_CHARS=4000
MODEL_AUDIT_ENABLED=true
MODEL_AUDIT_RETENTION_DAYS=90
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
FMP_MCP_URL=http://fmp-mcp:8080/mcp
ADMIN_API_TOKEN=
MCP_SECRET_KEY=
SEARXNG_MCP_URL=http://search-mcp:8080/mcp
WEKNORA_DEFAULT_URL=http://10.15.0.28/
SEARXNG_SECRET=
# Required for direct SEC EDGAR verification, e.g. "Your Name you@example.com".
SEC_IDENTITY=
# Comma-separated licensed/professional feeds and official exchange/IR feeds.
RSS_FEED_URLS=
OFFICIAL_RSS_FEED_URLS=
AKSHARE_ASSET_MASTER_ENABLED=true
AKSHARE_IPV4_ONLY=false

SCAN_INTERVAL_MINUTES=10
SCAN_BATCH_SIZE=40
EVENT_CLUSTER_WINDOW_HOURS=72
TARGETED_EVIDENCE_LIMIT=120
FMP_RATE_LIMIT_PER_MINUTE=240
FMP_NEWS_LOOKBACK_HOURS=12
AUTO_RESEARCH=true
AUTO_PAPER_TRADE=false
EVOLUTION_ENABLED=false
EVOLUTION_AUTO_MERGE=false

# Optional OpenAI-compatible verifier. Disabled when URL or key is blank.
CLOUD_LLM_BASE_URL=
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=
