FROM golang:1.21-bookworm AS go-build
WORKDIR /src
COPY backend-go/go.mod backend-go/go.sum* ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY backend-go ./
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

FROM docker:27-cli@sha256:851f91d241214e7c6db86513b270d58776379aacc5eb9c4a87e5b47115e3065c AS docker-cli

FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends docker.io git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml ./
COPY backend ./backend
RUN pip install --upgrade pip && pip install ".[markets,embeddings,dev]"

COPY --from=go-build /out/worker /usr/local/bin/worker
COPY --from=go-build /usr/local/go /usr/local/go
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose

ENV PATH="/usr/local/go/bin:${PATH}"

ENTRYPOINT ["/usr/local/bin/worker"]
